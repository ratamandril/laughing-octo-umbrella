{
  "manifest_version": 3,
  "name": "Notas por URL",
  "version": "1.5.1",
  "description": "Como los favoritos, pero para notas: adjunta notas con descripción, etiquetas y categorías de color a una página o a un sitio completo.",
  "permissions": ["storage", "tabs", "contextMenus", "alarms"],
  "action": {
    "default_title": "Notas por URL",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "MacCtrl+Shift+N"
      },
      "description": "Abrir Notas por URL"
    }
  }
}
